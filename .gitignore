venv/
__pycache__/
.ipynb_checkpoints/
outputs/
.cache/
data/raw/*
# A `!` negation can't reach into a directory excluded by the pattern above unless
# the directory itself is re-included first — hence the un-ignore/re-ignore/
# un-ignore cascade below (see: git history "Force add test_results.csv", which
# worked around this same gitignore limitation instead of fixing it).
!data/raw/team-stats/
data/raw/team-stats/*
!data/raw/team-stats/team-records.csv
!data/raw/master-stats/
data/raw/master-stats/*
!data/raw/master-stats/test_results.csv
!data/raw/master-stats/model_metadata.json
